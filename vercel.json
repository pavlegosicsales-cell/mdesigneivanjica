{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "site",
  "cleanUrls": false,
  "trailingSlash": false,

  "redirects": [
    { "source": "/pocetna", "destination": "/", "statusCode": 301 },
    { "source": "/usluge", "destination": "/modeli.html", "statusCode": 301 },
    { "source": "/usluge/a-frame-kuca-tip-a", "destination": "/modeli/a-frame.html", "statusCode": 301 },
    { "source": "/usluge/a-frame-kuca-tip-b-bocni-zidovi", "destination": "/modeli/a-frame.html", "statusCode": 301 },
    { "source": "/usluge/a-frame-kuca-tip-c-puni-zidovi", "destination": "/modeli/a-frame.html", "statusCode": 301 },
    { "source": "/usluge/:put*", "destination": "/modeli.html", "statusCode": 301 },
    { "source": "/galerija", "destination": "/galerija.html", "statusCode": 301 },
    { "source": "/galerija/a-frame-kuce", "destination": "/modeli/a-frame.html", "statusCode": 301 },
    { "source": "/galerija/montazne-kuce", "destination": "/modeli/montazne-kuce.html", "statusCode": 301 },
    { "source": "/galerija/:put*", "destination": "/galerija.html", "statusCode": 301 },
    { "source": "/o-nama", "destination": "/o-nama.html", "statusCode": 301 },
    { "source": "/kontakt", "destination": "/kontakt.html", "statusCode": 301 },
    { "source": "/cart", "destination": "/", "statusCode": 301 },
    { "source": "/cenovnik", "destination": "/cenovnik.html", "statusCode": 301 },
    { "source": "/modeli", "destination": "/modeli.html", "statusCode": 301 },
    { "source": "/blog", "destination": "/blog.html", "statusCode": 301 }
  ],

  "headers": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "mdesigneivanjica.vercel.app" }],
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/images/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=2592000, stale-while-revalidate=86400" }]
    },
    {
      "source": "/video/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=2592000, stale-while-revalidate=86400" }]
    },
    {
      "source": "/katalozi/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }]
    },
    {
      "source": "/css/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }]
    },
    {
      "source": "/js/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
